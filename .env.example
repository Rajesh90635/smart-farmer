# Copy this file to .env and fill in real local values.
# NEVER commit the actual .env file - it's excluded in .gitignore.

# --- PostgreSQL (used by docker-compose and/or local dev) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-devpassword
POSTGRES_DB=smart_farmer_dev

# --- pgAdmin (Docker Compose only) ---
PGADMIN_EMAIL=dev@example.com
PGADMIN_PASSWORD=changeme-pgadmin

# --- Backend (app/core/config.py reads these) ---
# Full SQLAlchemy DSN. When running the backend outside Docker against the
# Dockerized Postgres above, host is "localhost"; inside Docker Compose,
# host is "postgres" (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg://postgres:changeme-devpassword@localhost:5432/smart_farmer_dev

# Generate a real random value locally, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse this placeholder anywhere beyond your own machine.
JWT_SIGNING_KEY=replace-with-a-long-random-value-generated-locally

ENVIRONMENT=development

# --- AI service ---
AI_ENVIRONMENT=development
AI_VISION_PROVIDER=none
AI_LLM_PROVIDER=none
